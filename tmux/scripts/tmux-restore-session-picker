#!/usr/bin/env bash
set -euo pipefail

snapshot_dir="$HOME/.config/tmux/snapshots"
restore_script="$HOME/.config/tmux/scripts/tmux-restore-session-snapshot"

decode_b64() {
    printf '%s' "$1" | base64 -d
}

print_kv() {
    printf '%-16s %s\n' "$1" "$2"
}

show_preview() {
    local snapshot_name="$1"
    local snapshot_file="$snapshot_dir/${snapshot_name}.tmux-session"
    local session_name=''

    if [[ ! -f "$snapshot_file" ]]; then
        printf 'Snapshot not found\n'
        exit 0
    fi

    while IFS=$'\t' read -r record_type field1 field2 field3 field4; do
        case "$record_type" in
            session)
                session_name="$(decode_b64 "$field1")"
                print_kv 'Action' 'restore snapshot'
                print_kv 'Snapshot' "$snapshot_name"
                print_kv 'Target' "$session_name"
                if tmux has-session -t "=$session_name" 2>/dev/null; then
                    print_kv 'Result' 'replace existing live session'
                else
                    print_kv 'Result' 'create new live session'
                fi
                printf '\n'
                ;;
            window)
                window_flag=' '
                if [[ "$field2" == "1" ]]; then
                    window_flag='*'
                fi
                printf '%s window     %s\n' "$window_flag" "$(decode_b64 "$field3")"
                ;;
            pane)
                pane_flag=' '
                if [[ "$field3" == "1" ]]; then
                    pane_flag='*'
                fi
                printf '  %s pane       %s\n' "$pane_flag" "$(decode_b64 "$field4")"
                ;;
        esac
    done < "$snapshot_file"
}

if [[ "${1:-}" == "--preview" ]]; then
    show_preview "${2:-}"
    exit 0
fi

if [[ ! -d "$snapshot_dir" ]]; then
    tmux display-message "No saved session snapshots"
    exit 0
fi

mapfile -t target_snapshots < <(
    find "$snapshot_dir" -maxdepth 1 -type f -name '*.tmux-session' -printf '%f\n' | \
    sed 's/\.tmux-session$//' | \
    sort | \
    fzf \
        --prompt='restore session: ' \
        --border \
        --multi \
        --bind='tab:toggle,btab:toggle' \
        --preview="$0 --preview {}" \
        --preview-window='right:55%:border-left:wrap'
) || exit 0

if [[ ${#target_snapshots[@]} -eq 0 ]]; then
    exit 0
fi

restored_count=0
last_session=''
for target_snapshot in "${target_snapshots[@]}"; do
    [[ -z "$target_snapshot" ]] && continue
    "$restore_script" --no-switch "$snapshot_dir/${target_snapshot}.tmux-session"
    restored_count=$((restored_count + 1))
    last_session="$target_snapshot"
done

if [[ -n "$last_session" ]]; then
    tmux switch-client -t "$last_session" 2>/dev/null || true
fi

if [[ "$restored_count" -eq 1 ]]; then
    tmux display-message "Restored session snapshot: $last_session"
elif [[ "$restored_count" -gt 1 ]]; then
    tmux display-message "Restored $restored_count session snapshots"
fi
