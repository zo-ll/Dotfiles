#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
raw_session="${2:-}"
snapshot_dir="$HOME/.config/tmux/snapshots"

normalize_session() {
    local value="$1"

    if [[ "$value" == *$'\t'* ]]; then
        value="${value%%$'\t'*}"
    fi

    if [[ ${#value} -ge 2 ]]; then
        case "${value:0:2}" in
            "* "|"  ") value="${value:2}" ;;
        esac
    fi

    printf '%s\n' "$value"
}

print_kv() {
    printf '\033[1;32m%-16s\033[0m %s\n' "$1" "$2"
}

show_live_session() {
    local session="$1"
    local clients popup_exists

    if ! tmux has-session -t "=$session" 2>/dev/null; then
        printf 'Session not found: %s\n' "$session"
        exit 0
    fi

    clients="$(( $(tmux list-clients -F '#{session_name}' 2>/dev/null | awk -v target="$session" '$0 == target { count++ } END { print count + 0 }') ))"
    if tmux has-session -t "=${session}_popup" 2>/dev/null; then
        popup_exists='yes'
    else
        popup_exists='no'
    fi

    print_kv 'Session' "$session"
    print_kv 'Attached' "$clients client(s)"
    print_kv 'Popup sibling' "$popup_exists"
    printf '\n'

    while IFS=$'\t' read -r window_index window_active window_name; do
        window_flag=' '
        if [[ "$window_active" == "1" ]]; then
            window_flag='\033[1;32m*\033[0m'
        fi

        printf '%s window %-3s %s\n' "$window_flag" "$window_index" "$window_name"

        while IFS=$'\t' read -r pane_index pane_active pane_command pane_path; do
            pane_flag=' '
            if [[ "$pane_active" == "1" ]]; then
                pane_flag='\033[1;32m*\033[0m'
            fi

            printf '  %s pane %-3s %-14s %s\n' "$pane_flag" "$pane_index" "$pane_command" "$pane_path"
        done < <(
            tmux list-panes -t "=$session:$window_index" \
                -F '#{pane_index}'$'\t''#{pane_active}'$'\t''#{pane_current_command}'$'\t''#{pane_current_path}'
        )

        printf '\n'
    done < <(
        tmux list-windows -t "=$session" \
            -F '#{window_index}'$'\t''#{window_active}'$'\t''#{window_name}'
    )
}

session="$(normalize_session "$raw_session")"

if [[ -z "$mode" || -z "$session" ]]; then
    printf 'Usage: %s <switch|kill|save> <session>\n' "$0"
    exit 0
fi

case "$mode" in
    switch)
        print_kv 'Action' 'switch client'
        print_kv 'Target' "$session"
        printf '\n'
        show_live_session "$session"
        ;;
    kill)
        print_kv 'Action' 'kill session'
        print_kv 'Target' "$session"
        print_kv 'Also kills' "${session}_popup (if present)"
        printf '\n'
        show_live_session "$session"
        ;;
    save)
        print_kv 'Action' 'save snapshot'
        print_kv 'Target' "$session"
        print_kv 'Snapshot file' "$snapshot_dir/$session.tmux-session"
        printf '\n'
        show_live_session "$session"
        ;;
    *)
        printf 'Unknown mode: %s\n' "$mode"
        exit 0
        ;;
esac
