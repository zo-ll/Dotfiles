#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.config/tmux/scripts/tmux-fzf-colors"

snapshot_dir="$HOME/.config/tmux/snapshots"

decode_b64() {
    printf '%s' "$1" | base64 -d
}

print_kv() {
    printf '\033[1;32m%-16s\033[0m %s\n' "$1" "$2"
}

show_preview() {
    local snapshot_name="$1"
    local snapshot_file="$snapshot_dir/${snapshot_name}.tmux-session"
    local session_name=''

    if [[ ! -f "$snapshot_file" ]]; then
        printf 'Snapshot not found\n'
        exit 0
    fi

    while IFS=$'\t' read -r record_type field1 field2 field3 field4; do
        case "$record_type" in
            session)
                session_name="$(decode_b64 "$field1")"
                print_kv 'Action' 'delete snapshot'
                print_kv 'Snapshot' "$snapshot_name"
                print_kv 'Saved session' "$session_name"
                print_kv 'Result' 'live tmux sessions untouched'
                printf '\n'
                ;;
            window)
                window_flag=' '
                if [[ "$field2" == "1" ]]; then
                    window_flag=$'\033[1;32m*\033[0m'
                fi
                printf '%s window     %s\n' "$window_flag" "$(decode_b64 "$field3")"
                ;;
            pane)
                pane_flag=' '
                if [[ "$field3" == "1" ]]; then
                    pane_flag=$'\033[1;32m*\033[0m'
                fi
                printf '  %s pane       %s\n' "$pane_flag" "$(decode_b64 "$field4")"
                ;;
        esac
    done < "$snapshot_file"
}

if [[ "${1:-}" == "--preview" ]]; then
    show_preview "${2:-}"
    exit 0
fi

if [[ ! -d "$snapshot_dir" ]]; then
    tmux display-message "No saved session snapshots"
    exit 0
fi

mapfile -t target_snapshots < <(
    find "$snapshot_dir" -maxdepth 1 -type f -name '*.tmux-session' -printf '%f\n' | \
    sed 's/\.tmux-session$//' | \
    sort | \
    env -u FZF_DEFAULT_OPTS fzf \
        --prompt='delete snapshot: ' \
        --layout=reverse-list \
        $FZF_COLORS \
        $FZF_OPTS \
        --multi \
        --bind='tab:toggle,btab:toggle' \
        --preview="$0 --preview {}" \
        --preview-window='right:55%:border-left:wrap'
) || exit 0

if [[ ${#target_snapshots[@]} -eq 0 ]]; then
    exit 0
fi

for target_snapshot in "${target_snapshots[@]}"; do
    [[ -z "$target_snapshot" ]] && continue
    rm -f "$snapshot_dir/${target_snapshot}.tmux-session"
done

tmux display-message "Deleted ${#target_snapshots[@]} snapshot(s)"
