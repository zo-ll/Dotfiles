#!/bin/bash
# Power profile switcher via wofi

choice=$(echo -e "Performance\nBalanced\nPower Saver" | wofi --dmenu --prompt "Power Profile" --insensitive)

case "$choice" in
    Performance) powerprofilesctl set performance ;;
    Balanced)    powerprofilesctl set balanced ;;
    "Power Saver") powerprofilesctl set power-saver ;;
esac
