#!/bin/bash
# bootstrap — set up a new machine from zero
# Usage: curl -fsSL https://raw.githubusercontent.com/zo-ll/bootstrap/main/bootstrap.sh | bash
set -euo pipefail

# ── Helpers ───────────────────────────────────────────────────────────────
info()  { printf "\033[34m→\033[0m %s\n" "$1"; }
ok()    { printf "\033[32m✓\033[0m %s\n" "$1"; }

# ── SSH keys ──────────────────────────────────────────────────────────────
generate_ssh_keys() {
    local email="${1:-andrea@zollini.dev}"

    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"

    local keys=(
        "vps:$email"
        "gh:$email"
    )

    for entry in "${keys[@]}"; do
        local name="${entry%%:*}"
        local key_email="${entry##*:}"
        local key="$HOME/.ssh/$name"

        if [ -f "$key" ]; then
            info "SSH key already exists: $key"
        else
            ssh-keygen -t ed25519 -C "$key_email" -f "$key" -N "" >/dev/null 2>&1
            ok "SSH key generated: $key"
        fi
    done

    # Write SSH config
    if [ ! -f "$HOME/.ssh/config" ]; then
        cat > "$HOME/.ssh/config" << 'CONFIG'
Host gh
    HostName github.com
    User git
    IdentityFile ~/.ssh/gh

Host vps
    HostName YOUR_VPS_IP
    User root
    IdentityFile ~/.ssh/vps
CONFIG
        chmod 600 "$HOME/.ssh/config"
        ok "SSH config written (~/.ssh/config) — edit YOUR_VPS_IP"
    else
        info "SSH config already exists, skipping"
    fi

    # Start agent and add keys
    eval "$(ssh-agent -s)" >/dev/null 2>&1
    for f in "$HOME/.ssh/vps" "$HOME/.ssh/gh"; do
        [ -f "$f" ] && ssh-add "$f" >/dev/null 2>&1
    done
    ok "SSH agent started, keys added"

    # Print public keys
    echo ""
    echo "  ┌─ Public keys ────────────────────────────────────────┐"
    for f in "$HOME/.ssh/vps.pub" "$HOME/.ssh/gh.pub"; do
        if [ -f "$f" ]; then
            name="$(basename "$f" .pub)"
            printf "  │ \033[1m%s\033[0m\n" "$name"
            cat "$f" | sed 's/^/  │   /'
            echo ""
        fi
    done
    echo "  └──────────────────────────────────────────────────────┘"

    # Remind to add gh key to GitHub
    echo "  Add ~/.ssh/gh.pub to https://github.com/settings/keys"
    echo "  Then: ssh -T gh"
    echo ""
}

# ── Base packages ────────────────────────────────────────────────────────
install_base() {
    local pkgs=(tmux neovim git curl gh)

    sudo apt update >/dev/null 2>&1
    sudo apt install -y "${pkgs[@]}" >/dev/null 2>&1
    ok "Base packages installed (tmux, neovim, git, curl, gh)"
}

# ── Dotfiles (tmux only) ─────────────────────────────────────────────────
install_dotfiles() {
    if [ -d "$HOME/.config-repo" ]; then
        info "Dotfiles already cloned, pulling latest"
        git -C "$HOME/.config-repo" pull --rebase >/dev/null 2>&1
    else
        gh repo clone zo-ll/Dotfiles "$HOME/.config-repo" >/dev/null 2>&1
        ok "Dotfiles cloned"
    fi

    # Symlink tmux config only
    local src="$HOME/.config-repo/tmux/.config/tmux"
    local dst="$HOME/.config/tmux"
    if [ -d "$src" ]; then
        mkdir -p "$(dirname "$dst")"
        ln -sfT "$src" "$dst"
        ok "tmux config linked"
    fi

    # Link bootstrap script itself to ~/.local/bin
    mkdir -p "$HOME/.local/bin"
    ln -sf "$HOME/.config-repo/scripts/bootstrap" "$HOME/.local/bin/bootstrap"
    ok "bootstrap linked to ~/.local/bin/bootstrap"
}

# ── Run ───────────────────────────────────────────────────────────────────
main() {
    echo ""
    echo "  ╔═══════════════════════════════════════════╗"
    echo "  ║          machine bootstrap                ║"
    echo "  ╚═══════════════════════════════════════════╝"
    echo ""

    generate_ssh_keys
    install_base
    install_dotfiles

    echo ""
    ok "Bootstrap complete."
    echo ""
    echo "  Next steps:"
    echo "    tmux          # start tmux (config auto-loaded)"
    echo "    ssh -T gh     # test GitHub SSH access"
    echo "    gh auth login # auth GitHub CLI"
    echo ""
}

main "$@"
